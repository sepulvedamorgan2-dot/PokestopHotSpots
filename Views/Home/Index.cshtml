@model List<Hotspot>
@{
    ViewData["Title"] = "Pokestop Hot Spots";
    var featuredHotspot = Model.FirstOrDefault(e => e.GymCount > 2);
}

<div class="row justify-content-center my-5">
    <div class="col-12 col-lg-8 text-center">
        <h1 class="display-4 fw-bold text-dark mb-3">Find Pokémon GO Hotspots</h1>
        <p class="lead text-muted mb-4">Discover high-density Pokéstops, competitive Gym clusters, and parking availability before your next community raid.</p>
        <div class="d-grid gap-2 d-md-flex justify-content-center">
            <a asp-controller="Hotspots" asp-action="Index" class="btn btn-primary btn-lg px-4 gap-2 shadow-sm">
                <i class="bi bi-geo-alt-fill"></i> View the Hotspots
            </a>
        </div>
    </div>
</div>

<div id="featured-section" class="row justify-content-center mt-5">
    <h1 class="col-12 col-lg-8 fs-2 fw-bold text-dark mb-3">Featured Hotspot</h1>
</div>

<div class="row justify-content-center mt-2 mb-5">
    @if (featuredHotspot != null)
    {
        <partial name="_HotspotCard" model="featuredHotspot" />
    }
    else
    {
        <div class="col-12 col-lg-8">
            <div class="d-flex flex-column align-items-center justify-content-center text-center border border-dashed rounded-4 p-4 w-100 bg-white" style="height: 200px; border-style: dashed !important;">
                <i class="bi bi-geo-alt text-muted mb-2 fs-3"></i>
                <p class="text-muted small mb-3 fw-medium">No Hotspots with 3+ Gyms added yet</p>
                <a class="btn btn-sm btn-primary px-3 shadow-sm" asp-controller="HotSpots" asp-action="Create">
                    <i class="bi bi-plus-lg me-1"></i>Add Hotspot
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    
}