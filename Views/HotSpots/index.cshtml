@model List<Hotspot>
@{
    ViewData["Title"] = "Hot Spots";
    ViewData["PreviousPage"] = Url.Content("/");
    ViewData["FormButton"] = Url.Content("/HotSpots/Create");
}
@* <div class="row justify-content-center my-3"> *@
@* <partial name="_BackArrow" /> *@
@* </div> *@
<a href="/HotSpots/Create" 
   class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center shadow-lg position-fixed" 
   style="bottom: 30px; right: 30px; width: 60px; height: 60px; z-index: 1050; transition: transform 0.2s ease;"
   onmouseover="this.style.transform='scale(1.1)'" 
   onmouseout="this.style.transform='scale(1)'"
   title="Create New Hotspot">
    <p class="bi bi-plus-lg fs-3 pt-3" style="text-decoration: none">+</p>
</a>
<h2>Hot Spots</h2>
<div class="table-responsive">
    <table class="table table-striped">
        <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Name</th>
            <th scope="col">Gym Count</th>
            <th scope="col">Pokestop Density</th>
            <th scope="col">Parking Available</th>
            <th scope="col">Action</th>
        </tr>
        </thead>
        <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center py-4">
                    <p class="mb-2">No Hotspots found.</p>
                    <a href="/HotSpots/Create" class="btn btn-primary btn-sm">Create New Hotspot</a>
                </td>
            </tr>
        }
        else
        {
            @foreach (Hotspot hotSpot in Model)
            {
                <tr> 
                    <th scope="row">@hotSpot.Id</th>
                    <td>@hotSpot.Name</td>
                    <td>@hotSpot.GymCount</td>
                    <td>@hotSpot.PokestopDensity</td>
                    <td>@(hotSpot.hasParking ? "Yes" : "No")</td>
                    <td><a href="/HotSpots/Details/@hotSpot.Id" class="btn btn-sm btn-outline-secondary">Details</a></td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
