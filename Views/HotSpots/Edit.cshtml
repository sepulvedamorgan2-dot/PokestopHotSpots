
@model Hotspot
@{
    ViewData["Title"] = "Edit " + @Model.Name + " Hot Spot";
    ViewData["PreviousPage"] = Url.Content("/HotSpots/Details/" + @Model.Id);
}
<div class="row justify-content-center my-3">
    <div class="mb-2">
        <partial name="_BackArrow" />
    </div>
   
       
        <h1 class="col-12 col-lg-8">Edit @Model.Name</h1>


   
<form asp-action="Edit" method="post" class="col-12 col-lg-8">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control " style="resize: none;" rows="3"></
        </textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
   
    <div class="mb-3">
        <label asp-for="GymCount" class="form-label"></label>
        <input asp-for="GymCount" class="form-control" />
        <span asp-validation-for="GymCount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PokestopDensity" class="form-label"></label>
        <select asp-for="PokestopDensity" class="form-control" >  
            <option selected value="Low">Low</option>
            <option value="Medium">Medium</option>
            <option value="High">High</option>
        </select>
        <span asp-validation-for="PokestopDensity" class="text-danger"></span>
    </div>


   


   
    <div class="form-check mb-3">
        <input asp-for="hasParking" class="form-check-input" />
        <label asp-for="hasParking" class="form-check-label"></label>
    </div>


    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="ms-1 btn btn-danger">Delete HotSpot</a>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    
</form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

