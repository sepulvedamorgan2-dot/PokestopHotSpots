
@model Hotspot;

@{
    
    
   @* var imgPath = Url.Content("~/images/" + @Model.Id + ".jpg");

   Right now I only have one image, in the future this will be based on submitted data witht he commented out code above.
    *@
    var imgPath = Url.Content("~/images/1.jpg");
   
}
<div class="col-12 col-lg-8">
<div class="card w-100 ">
    <div class="card-img-top">
        <img src="@imgPath" class="card-img-top img-fluid" alt="" />

    <div class="card-body">
    <div class="row">
    <div class="col-12 col-lg-6">
        <h5 class="card-title fs-3">@Model.Name</h5>
        <p class="card-text">@Model.Description</p>
        <p class="card-text">Regular Players: @Model.HotspotRegulars.Count </p>
        
         @if (ViewData["Title"] != "Pokestop Hot Spots")
        {
            <p class="card-text">@Model.GymCount gyms</p>
            <p class="card-text">@Model.PokestopDensity Pokestop Density</p>
            <p class="card-text">@(Model.hasParking ? " Parking Available" : "No Parking Available")</p>
            
        }
        @if (!ViewData["Title"].ToString().Contains("Details"))
        {
          
        }
        
    </div>
    <div class="col-12 col-lg-6">
        @if (ViewData["Title"] != "Pokestop Hot Spots" && Model.HotspotRegulars.Count > 0)
        {
        
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Friendship Code</th>
                        <th scope="col">Looking for Friends</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var regular in Model.HotspotRegulars)
                    {
                        <tr>
                            <td>@regular.Name</td>
                            
                            <td>
                                @(regular.SendsDailyGifts ? regular.FriendshipCode : "Not Seeking Friends")
                            </td>
                            <td>
                                @(regular.SendsDailyGifts ? "Yes" : "No")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            
        }
        
    </div>
    </div>
    <div class="pt-2">
    
    @if (ViewData["Title"] != "Pokestop Hot Spots")
        {
          <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary" type="button">Edit HotSpot</a>
          <a asp-controller="HotSpotRegulars" asp-action="Create" asp-route-id="@Model.Id" class="btn btn-primary" type="button">Add Regular</a>
          
        }
        @if (!ViewData["Title"].ToString().Contains("Details"))
        {
           <a href="/HotSpots/Details/@Model.Id" class="btn btn-primary" type="button">View Details</a>
         
        }
        </div>
    </div>
</div>
</div>
