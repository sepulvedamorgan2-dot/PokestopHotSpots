
@model Hotspot;

@{
    @* var imgPath = Url.Content("~/images/" + @Model.Id + ".jpg");

   Right now I only have one image, in the future this will be based on submitted data witht he commented out code above.
    
    

    



    







    *@
    var imgPath = Url.Content("~/images/1.jpg");
}
<div class="col-12 col-lg-8">
    <div class="card rounded-4 w-100">
        <div class="card-img-top">
            <img src="@imgPath" class="card-img-top img-fluid rounded-top-4" alt=""/>
            <div class="card-body">
                <div class="border-0 bg-white overflow-hidden hover-lift">
                    <div class="row g-4 align-items-stretch">

                        <div class="col-12 col-lg-6 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center mb-3">
                                    <h5 class="card-title fs-3 fw-bold mb-0 text-dark">@Model.Name</h5>
                                </div>
                                <p class="card-text text-muted mb-4 small lh-sm">@Model.Description</p>
                            </div>

                            <div class="mt-auto border-top border-light pt-2">
                                

                                @if (ViewData["Title"] != "Pokestop Hot Spots")
                                {
                                    <div
                                        class="d-flex justify-content-between align-items-center py-2 border-bottom border-light-subtle mb-0">
                                        <span class="text-secondary small d-flex align-items-center lh-1">
                                            <i class="bi bi-people text-info me-2 fs-6 d-flex align-items-center"></i>Regular Players
                                        </span>
                                        <span
                                            class="badge bg-info bg-opacity-10 text-info-emphasis rounded-pill px-2.5 py-1.5 fw-bold lh-1">
                                            @Model.HotspotRegulars.Count
                                        </span>
                                    </div>
                                    <div
                                        class="d-flex justify-content-between align-items-center py-2 border-bottom border-light-subtle mb-0">
                                        <span class="text-secondary small d-flex align-items-center lh-1">
                                            <i class="bi bi-shield-shaded text-danger me-2 fs-6 d-flex align-items-center"></i>Total Gyms
                                        </span>
                                        <span class="fw-semibold text-dark lh-1">@Model.GymCount</span>
                                    </div>

                                    <div
                                        class="d-flex justify-content-between align-items-center py-2 border-bottom border-light-subtle mb-0">
                                        <span class="text-secondary small d-flex align-items-center lh-1">
                                            <i class="bi bi-layers-half text-warning-emphasis me-2 fs-6 d-flex align-items-center"></i>Stop Density
                                        </span>
                                        <span class="fw-semibold text-dark lh-1">@Model.PokestopDensity</span>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center py-2 mb-0">
                                        <span class="text-secondary small d-flex align-items-center lh-1">
                                            <i class="bi bi-car-front me-2 fs-6 d-flex align-items-center"></i>Parking Availability
                                        </span>
                                        <span
                                            class="badge @(Model.hasParking ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") rounded px-2 py-1.5 small fw-medium lh-1">
                                            @(Model.hasParking ? "Available" : "None")
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 d-flex flex-column justify-content-start">
                            @if (ViewData["Title"] != "Pokestop Hot Spots" && Model.HotspotRegulars.Count > 0)
                            {
                                <div class="pt-lg-0 pt-0 h-100 d-flex flex-column">
                                    <button
                                        class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center py-2 fw-medium shadow-sm transition-all"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapsePlayers-@Model.Name.Replace(" ", "")"
                                        aria-expanded="false"
                                        aria-controls="collapsePlayers-@Model.Name.Replace(" ", "")">
                                        <i class="bi bi-person-lines-fill me-2"></i> View Regular Players
                                    </button>

                                    <div class="collapse mt-3 flex-grow-1"
                                         id="collapsePlayers-@Model.Name.Replace(" ", "")">
                                        <div
                                            class="card card-body p-0 border border-light-subtle rounded-3 overflow-hidden shadow-sm"
                                            style="max-height: 240px; overflow-y: auto;">
                                            <table class="table table-hover table-striped mb-0 small align-middle">
                                                <thead class="table-light sticky-top border-bottom">
                                                <tr>
                                                    <th scope="col" class="ps-3 py-2 text-secondary">Trainer Name</th>
                                                    <th scope="col" class="py-2 text-secondary">Friend Code</th>
                                                    <th scope="col" class="pe-3 py-2 text-end text-secondary">Seeking
                                                        Friends
                                                    </th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                @foreach (var regular in Model.HotspotRegulars)
                                                {
                                                    <tr>
                                                        <td class="ps-3 fw-medium text-dark">@regular.Name</td>
                                                        <td class="font-monospace text-muted">
                                                            @(regular.SendsDailyGifts ? regular.FriendshipCode : "—")
                                                        </td>
                                                        <td class="pe-3 text-end">
                                                            @if (regular.SendsDailyGifts)
                                                            {
                                                                <span
                                                                    class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-0.5">Yes</span>
                                                            }
                                                            else
                                                            {
                                                                <span
                                                                    class="badge bg-light text-secondary rounded-pill px-2 py-0.5">No</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="pt-0 mt-2">

                            @if (ViewData["Title"] != "Pokestop Hot Spots")
                            {
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary" type="button">Edit
                                    HotSpot</a>
                                <a asp-controller="HotSpotRegulars" asp-action="Create" asp-route-id="@Model.Id"
                                   class="btn btn-success" type="button">Add Regular</a>
                            }
                            @if (!ViewData["Title"].ToString().Contains("Details"))
                            {
                                <a href="/HotSpots/Details/@Model.Id" class="btn btn-primary" type="button">View
                                    Details</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


